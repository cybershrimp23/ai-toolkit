FROM rocm/pytorch:rocm7.2.2_ubuntu24.04_py3.12_pytorch_release_2.10.0

LABEL description="ai-toolkit with ROCm support for AMD gfx1201 (R9700 AI Pro)"

# Avoid interactive prompts
ENV DEBIAN_FRONTEND=noninteractive

# Install system deps
RUN apt-get update && apt-get install --no-install-recommends -y \
    git \
    curl \
    build-essential \
    cmake \
    wget \
    ffmpeg \
    tmux \
    htop \
    rsync \
    unzip \
    xz-utils \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Install Node.js 23.11.1 from the official tarball — pinned by exact version and sha256.
# Using the tarball avoids relying on nodesource apt repo availability.
ENV NODE_VERSION=23.11.1
RUN curl -fsSL "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-x64.tar.xz" \
      -o /tmp/node.tar.xz && \
    echo "64220ef391e74bb8feafe51a17764eff908f0cfd7f6c2c184fe8361fb8520a44  /tmp/node.tar.xz" \
      | sha256sum -c - && \
    tar -xJf /tmp/node.tar.xz -C /usr/local --strip-components=1 && \
    rm /tmp/node.tar.xz

# ROCm / HIP environment variables
# gfx1201 is the R9700 AI Pro - set override in case kernel reports differently
ENV PATH=/opt/rocm/bin:$PATH
ENV HSA_OVERRIDE_GFX_VERSION=12.0.1
ENV PYTORCH_ROCM_ARCH=gfx1201
ENV HIP_VISIBLE_DEVICES=0,1
ENV ROCR_VISIBLE_DEVICES=0,1

# Performance / stability env vars (can be overridden at runtime)
ENV AMD_SERIALIZE_KERNEL=3
ENV TORCH_USE_HIP_DSA=1
ENV HSA_ENABLE_SDMA=0
ENV PYTORCH_ROCM_ALLOC_CONF=max_split_size_mb:768,garbage_collect=1
ENV ROCBLAS_USE_HIPBLASLT=0
ENV ROCBLAS_LOG_LEVEL=0
ENV HF_HUB_ENABLE_HF_TRANSFER=1

WORKDIR /app/ai-toolkit

# Copy pinned requirements first for better layer caching
COPY requirements.rocm.txt ./

# Install Python dependencies from fully-pinned requirements.
# torch/torchvision/torchaudio/apex/triton are intentionally excluded —
# they are already installed in the base image as ROCm-specific builds.
RUN pip install --no-cache-dir -r requirements.rocm.txt

# Copy the rest of the source
COPY . .

# Build the UI
WORKDIR /app/ai-toolkit/ui
RUN npm install && \
    npm run update_db && \
    npm run build

WORKDIR /app/ai-toolkit

# Models and dataset are mounted from host at runtime
# /app/ai-toolkit/models  -> host models/
# /app/ai-toolkit/dataset -> host dataset/
# /app/ai-toolkit/output  -> host output/ (for lora checkpoints)

EXPOSE 8675

CMD ["python", "run.py"]
